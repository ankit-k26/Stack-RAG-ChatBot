# ─────────────────────────────────────────────────────────────────────────────
# Stacks RAG — Server environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# ── Gemini API ──────────────────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# ── Vector store — Qdrant Cloud (free tier) ─────────────────────────────────
# Sign up at: https://cloud.qdrant.io
# Cluster URL looks like: https://abc123.us-east4-0.gcp.cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=stacks_session_

# ── Retrieval tuning ────────────────────────────────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TOP_K=5
SCORE_THRESHOLD=0.45

# ── Uploads ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=20

# ── Auth — MongoDB Atlas (free M0 tier) ──────────────────────────────────────
# Sign up at: https://www.mongodb.com/atlas
# Connection string from Atlas: Clusters → Connect → Drivers
MONGODB_URI=
# Generate a secure random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
